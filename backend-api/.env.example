APP_ENV=development
AUTO_SEED=true
SEED_DEMO_USER_COUNT=120
DATABASE_URL=sqlite:///./data/campus_card.db
JWT_SECRET=change-this-in-production
JWT_EXPIRES_SECONDS=86400
INTERNAL_TOKEN=local-internal-token-change-me
AI_BASE_URL=http://127.0.0.1:8001
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin12345
DEMO_MODE=true
DEMO_PROCESSING_SECONDS=3
DEMO_COMPLETED_SECONDS=10
RECHARGE_SINGLE_LIMIT=500
RECHARGE_DAILY_LIMIT=1000
CARD_BALANCE_LIMIT=5000
